{
  "manifest_version": 3,
  "name": "Fetaccino",
  "version": "1.0.0",
  "description": "Extracts Google business listings to Google Sheets",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png"
    }
  },
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "128": "icons/android-chrome-192x192.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://google.com/*",
        "*://*.google.co.in/*",
        "*://google.co.in/*"
      ],
      "js": [
        "src/content/index.ts"
      ]
    }
  ],
  "permissions": [
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "1011522631545-n9lj7q8helm1epod3u52kjir3371g1jq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "*://*.google.com/*",
    "*://google.com/*",
    "*://*.google.co.in/*",
    "*://google.co.in/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ]
}